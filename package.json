{
  "name": "taionca",
  "description": "taionca administrative software",
  "version": "1.0.0",
  "engines": {
    "node": "14.x"
  },
  "scripts": {
    "dev": "sapper dev",
    "build": "run-s build:db build:sapper",
    "build:sapper": "sapper build",
    "build:db": "run-s \"migrate up\" build:permissions.js",
    "build:permissions.js": "node -r esm ./src/scripts/build_permissions_constants.js",
    "export": "sapper export",
    "start": "node __sapper__/build",
    "create:permission": "node -r esm ./src/scripts/create_permission.js",
    "create:crudPermissions": "node -r esm ./src/scripts/create_crudPermissions.js",
    "migrate": "node-pg-migrate",
    "test": "node scripts/test.js",
    "test:all": "node scripts/test.js --build"
  },
  "dependencies": {
    "argon2": "^0.27.0",
    "body-parser": "^1.19.0",
    "chart.js": "^4.4.2",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-adapter-dayjs-4": "^1.0.4",
    "chartjs-adapter-luxon": "^1.3.1",
    "chartjs-plugin-zoom": "^2.0.1",
    "compose-middleware": "^5.0.1",
    "connect-pg-simple": "^6.2.1",
    "date-fns": "^3.6.0",
    "dayjs": "^1.11.11",
    "dotenv": "^16.4.5",
    "express-session": "^1.17.1",
    "fly": "^4.6.3",
    "luxon": "^3.4.4",
    "morgan": "^1.10.0",
    "node-fetch": "^2.6.1",
    "pg": "^8.4.1",
    "polka": "next",
    "sirv": "^1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@babel/plugin-syntax-dynamic-import": "^7.0.0",
    "@babel/plugin-transform-runtime": "^7.0.0",
    "@babel/preset-env": "^7.0.0",
    "@babel/runtime": "^7.0.0",
    "@playwright/test": "^1.45.1",
    "@rollup/plugin-babel": "^5.0.0",
    "@rollup/plugin-commonjs": "^14.0.0",
    "@rollup/plugin-json": "^4.1.0",
    "@rollup/plugin-node-resolve": "^8.0.0",
    "@rollup/plugin-replace": "^2.2.0",
    "@rollup/plugin-url": "^5.0.0",
    "carbon-components-svelte": "^0.32.1",
    "esm": "^3.2.25",
    "node-pg-migrate": "^5.8.1",
    "npm-run-all": "^4.1.5",
    "rollup": "^2.3.4",
    "rollup-plugin-svelte": "^6.0.0",
    "rollup-plugin-terser": "^7.0.0",
    "sapper": "^0.28.0",
    "svelte": "^3.17.3",
    "svelte-select": "^3.12.0"
  }
}
